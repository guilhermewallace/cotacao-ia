{
  "name": "cotacao-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cotação IA — SaaS multi-tenant de automação de cotações B2B para distribuidoras de materiais elétricos",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"next dev\" \"npm run worker:dev\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "worker:dev": "tsx watch scripts/worker.ts",
    "worker:build": "esbuild scripts/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:sql": "tsx scripts/migrate-sql.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "demo:setup": "npm run db:migrate && npm run db:seed",
    "demo:whatsapp": "tsx scripts/simulate-whatsapp.ts",
    "demo:email": "tsx scripts/simulate-email.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "landing:build": "tsx scripts/build-landing.ts",
    "pages:build": "tsx scripts/build-pages.ts",
    "org:create": "tsx scripts/create-organization.ts",
    "retention:purge": "tsx scripts/purge-retention.ts",
    "postinstall": "prisma generate || node -e \"console.warn('\\n[cotacao-ia] AVISO: prisma generate falhou (rede bloqueando binaries.prisma.sh?). Veja a secao Solucao de problemas do README.\\n')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@next/env": "^16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "bullmq": "^6.7.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "file-type": "^22.3.0",
    "geist": "^1.9.2",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "openai": "^7.63.0",
    "papaparse": "^5.7.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
