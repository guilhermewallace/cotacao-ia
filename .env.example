# ─────────────────────────────────────────────────────────────────────────────
# Cotação IA — variáveis de ambiente
#
# Copie para `.env` (cp .env.example .env). Os valores abaixo funcionam com o
# `docker compose up -d` deste repositório e NÃO exigem nenhum serviço externo:
# autenticação de demonstração, provedor de IA mock e storage S3 local (contêiner).
#
# Em produção, TODOS os segredos devem ser trocados. A aplicação se recusa a subir
# em produção com os valores de exemplo de SESSION_SECRET e ENCRYPTION_KEY.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
# URL pública da aplicação (usada nas URLs de webhook exibidas em Integrações).
APP_URL=http://localhost:3000
# Fuso horário usado em datas, cotações e no dashboard.
APP_TIMEZONE=America/Sao_Paulo
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Banco de dados (PostgreSQL 16 com pg_trgm e unaccent) ─────────────────────
DATABASE_URL=postgresql://cotacao:cotacao@localhost:5432/cotacao
DATABASE_POOL_MAX=10
# Banco usado pelos testes de integração (precisa terminar em "_test").
TEST_DATABASE_URL=postgresql://cotacao:cotacao@localhost:5432/cotacao_test
# Redis usado pelo teste da fila real (banco 15, separado do desenvolvimento). Sem Redis, esse teste é ignorado.
TEST_REDIS_URL=redis://localhost:6379/15

# ── Fila de processamento ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# bullmq: processamento pelo worker (npm run worker) — padrão.
# inline: processa no próprio processo web, sem Redis — apenas demonstração/testes.
QUEUE_DRIVER=bullmq
WORKER_CONCURRENCY=4

# ── Autenticação ─────────────────────────────────────────────────────────────
# demo: contas locais do seed, senha única DEMO_PASSWORD (somente demonstração).
# supabase: Supabase Auth (produção). Veja docs/integracoes/supabase-auth.md
AUTH_PROVIDER=demo
DEMO_PASSWORD=demo1234
# Necessário apenas se você realmente quiser publicar um ambiente de demonstração.
ALLOW_DEMO_AUTH_IN_PRODUCTION=false
# Segredo de sessão e de URLs temporárias (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Criptografia de credenciais de integração (AES-256-GCM) ───────────────────
# Chave de 32 bytes em base64. Gere com: openssl rand -base64 32
# ATENÇÃO: trocar a chave invalida as credenciais já salvas (será preciso informá-las de novo).
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# ── Armazenamento de documentos (privado, com URLs temporárias) ───────────────
# s3: qualquer storage compatível com S3 (o contêiner `storage` do docker compose, AWS S3, Cloudflare R2...).
# local: disco (LOCAL_STORAGE_DIR) — para rodar sem o contêiner de storage.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# Endpoint visto pelo NAVEGADOR, quando diferente do interno (ex.: app em contêiner).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=cotacao-ia
# Chaves do storage local do docker compose (apenas desenvolvimento).
S3_ACCESS_KEY_ID=cotacaodev
S3_SECRET_ACCESS_KEY=cotacaodevsecret
S3_FORCE_PATH_STYLE=true
# true: cria o bucket (privado) antes da primeira gravação, se ele ainda não existir — prático em
# desenvolvimento. Em produção, crie o bucket pela sua infraestrutura e deixe false.
S3_AUTO_CREATE_BUCKET=true
LOCAL_STORAGE_DIR=.data/storage
# Validade das URLs temporárias, em segundos.
SIGNED_URL_TTL_SECONDS=300
# Tamanho máximo por arquivo (upload e anexos de e-mail/WhatsApp).
MAX_UPLOAD_MB=20

# ── Inteligência artificial ──────────────────────────────────────────────────
# mock: extração determinística por regras + respostas fixas para os documentos de exemplo.
# anthropic | openai: extração por modelo de linguagem (texto, PDF e imagens).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Confira os IDs de modelo vigentes na documentação do provedor antes de publicar.
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Transcrição de áudios do WhatsApp: none | openai | mock
TRANSCRIPTION_PROVIDER=none
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Chave secreta e token de verificação do SEU aplicativo na Meta. Sem eles, o webhook responde 503.
# Os valores "dev-only-…" abaixo NÃO são credenciais da Meta: servem apenas ao simulador local
# (npm run demo:whatsapp e botão "Simular" em Integrações) e são recusados em produção.
# O token de acesso e o Phone Number ID de cada empresa são cadastrados na tela
# Integrações e ficam cifrados no banco. Veja docs/integracoes/whatsapp.md
WHATSAPP_APP_SECRET=dev-only-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=dev-only-whatsapp-verify-token
WHATSAPP_GRAPH_API_VERSION=v25.0

# ── Recebimento de e-mails por webhook ───────────────────────────────────────
# Domínio dos endereços de recebimento: <identificador-da-empresa>@<domínio>
EMAIL_INBOUND_DOMAIN=inbound.cotacao.localhost
# Webhook genérico assinado (HMAC-SHA256). Veja docs/integracoes/email.md
# O valor "dev-only-…" serve apenas ao simulador local (npm run demo:email) e é recusado em produção.
EMAIL_WEBHOOK_SECRET=dev-only-email-webhook-secret
# Postmark Inbound: usuário e senha do Basic Auth configurado na URL do webhook.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# ── Página pública (landing, em "/") ─────────────────────────────────────────
# WhatsApp do contato comercial, com DDI e DDD, só dígitos (ex.: 5511999999999). Os botões da página
# abrem uma conversa com esse número (link wa.me; não usa a integração da Cloud API acima).
# Vazio: os botões levam às demonstrações da própria página.
LANDING_WHATSAPP_NUMBER=
# Mensagem que já vem escrita na conversa. Este é o texto padrão; descomente para trocar.
# LANDING_WHATSAPP_MESSAGE=Olá! Vi a página do Cotação IA e quero saber mais.
